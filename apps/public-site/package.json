{
  "name": "@roadmaps/public-site",
  "private": true,
  "version": "0.0.0",
  "description": "DHCW public product roadmaps, prerendered from a snapshot of the Google Sheet and published by product-roadmaps.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm prerender",
    "prerender": "vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "ROADMAPS_DATA=e2e/fixtures/roadmaps.json pnpm build && node scripts/lighthouse.ts",
    "sync": "node scripts/sync-roadmaps.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "^4.14.1",
    "eslint": "catalog:",
    "eslint-plugin-i18next": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
