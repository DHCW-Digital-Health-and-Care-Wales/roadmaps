{
  "name": "roadmaps",
  "private": true,
  "version": "0.0.0",
  "description": "The DHCW roadmaps workspace: the Roadmap Editor, where Product Leads manage their public Now, Next, Later roadmaps (apps/editor), the public site that shows them (apps/public-site), and the API that will replace the spreadsheet behind them (apps/api).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DHCW-Digital-Health-and-Care-Wales/roadmaps.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "editor:dev": "pnpm --filter @roadmaps/editor dev",
    "editor:build": "pnpm --filter @roadmaps/editor build",
    "editor:preview": "pnpm --filter @roadmaps/editor preview",
    "editor:typecheck": "pnpm --filter @roadmaps/editor typecheck",
    "editor:lint": "pnpm --filter @roadmaps/editor lint",
    "editor:test": "pnpm --filter @roadmaps/editor test",
    "editor:test:e2e": "pnpm --filter @roadmaps/editor test:e2e",
    "site:sync": "pnpm --filter @roadmaps/public-site sync",
    "site:dev": "pnpm --filter @roadmaps/public-site dev",
    "site:build": "pnpm --filter @roadmaps/public-site build",
    "site:preview": "pnpm --filter @roadmaps/public-site preview",
    "site:typecheck": "pnpm --filter @roadmaps/public-site typecheck",
    "site:lint": "pnpm --filter @roadmaps/public-site lint",
    "site:test": "pnpm --filter @roadmaps/public-site test",
    "site:test:e2e": "pnpm --filter @roadmaps/public-site test:e2e",
    "site:lighthouse": "pnpm --filter @roadmaps/public-site lighthouse",
    "api:dev": "pnpm --filter @roadmaps/api dev",
    "api:db:up": "pnpm --filter @roadmaps/api db:up",
    "api:db:down": "pnpm --filter @roadmaps/api db:down",
    "api:migrate": "pnpm --filter @roadmaps/api migrate",
    "api:jaeger": "pnpm --filter @roadmaps/api jaeger",
    "api:jaeger:stop": "pnpm --filter @roadmaps/api jaeger:stop",
    "api:format": "pnpm --filter @roadmaps/api format",
    "api:typecheck": "pnpm --filter @roadmaps/api typecheck",
    "api:lint": "pnpm --filter @roadmaps/api lint",
    "api:test": "pnpm --filter @roadmaps/api test",
    "api:openapi": "pnpm --filter @roadmaps/api openapi",
    "api:openapi:check": "pnpm --filter @roadmaps/api openapi:check",
    "api:contract": "pnpm api:openapi && pnpm api-types:generate",
    "api-types:generate": "pnpm --filter @roadmaps/api-types generate",
    "api-types:check": "pnpm --filter @roadmaps/api-types check",
    "api-types:typecheck": "pnpm --filter @roadmaps/api-types typecheck",
    "api-types:lint": "pnpm --filter @roadmaps/api-types lint",
    "api-types:test": "pnpm --filter @roadmaps/api-types test",
    "knip": "knip",
    "repo:typecheck": "tsc -p tsconfig.json",
    "repo:lint": "eslint --max-warnings=0 .",
    "repo:test": "vitest run",
    "typecheck": "pnpm repo:typecheck && pnpm -r typecheck",
    "lint": "pnpm repo:lint && pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm repo:test && pnpm -r test",
    "test:docs": "vitest run build/markdown-links.test.ts build/agent-guides.test.ts",
    "build": "pnpm -r build",
    "postinstall": "node node_modules/lefthook/postinstall.js",
    "worktree:setup": "./scripts/worktree/worktree.sh setup",
    "worktree:info": "./scripts/worktree/worktree.sh info",
    "worktree:teardown": "./scripts/worktree/worktree.sh teardown"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.4",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "catalog:",
    "knip": "^6.45.1",
    "lefthook": "2.2.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  }
}
