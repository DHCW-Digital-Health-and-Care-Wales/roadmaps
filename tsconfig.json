// The root package's own TypeScript: the repository's checks, the worktree script's
// tests, their configs and the ESLint base the apps extend. Each app under apps/ has
// its own.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "types": ["node"]
  },
  "include": [
    "eslint.config.ts",
    "eslint.base.ts",
    "vitest.config.ts",
    "build",
    "scripts"
  ]
}
