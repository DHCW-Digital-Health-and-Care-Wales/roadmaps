{
  "name": "roadmaps",
  "private": true,
  "version": "0.0.0",
  "description": "The DHCW roadmaps workspace: the Roadmap Editor, where Product Leads manage their public Now, Next, Later roadmaps (apps/editor).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DHCW-Digital-Health-and-Care-Wales/roadmaps.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "editor:dev": "pnpm --filter @roadmaps/editor dev",
    "editor:build": "pnpm --filter @roadmaps/editor build",
    "editor:preview": "pnpm --filter @roadmaps/editor preview",
    "editor:typecheck": "pnpm --filter @roadmaps/editor typecheck",
    "editor:lint": "pnpm --filter @roadmaps/editor lint",
    "editor:test": "pnpm --filter @roadmaps/editor test",
    "editor:test:e2e": "pnpm --filter @roadmaps/editor test:e2e",
    "repo:typecheck": "tsc -p tsconfig.json",
    "repo:lint": "eslint --max-warnings=0 .",
    "repo:test": "vitest run",
    "typecheck": "pnpm repo:typecheck && pnpm -r typecheck",
    "lint": "pnpm repo:lint && pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm repo:test && pnpm -r test",
    "test:docs": "vitest run build/markdown-links.test.ts build/agent-guides.test.ts",
    "build": "pnpm -r build",
    "postinstall": "node node_modules/lefthook/postinstall.js",
    "worktree:setup": "./scripts/worktree/worktree.sh setup",
    "worktree:info": "./scripts/worktree/worktree.sh info",
    "worktree:teardown": "./scripts/worktree/worktree.sh teardown"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "lefthook": "2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  }
}
