{
  "name": "@roadmaps/public-site",
  "private": true,
  "version": "0.0.0",
  "description": "DHCW public product roadmaps, prerendered from a snapshot of the Google Sheet and published by product-roadmaps.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm prerender",
    "prerender": "vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "ROADMAPS_DATA=e2e/fixtures/roadmaps.json pnpm build && node scripts/lighthouse.ts",
    "sync": "node scripts/sync-roadmaps.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "eslint": "catalog:",
    "eslint-plugin-i18next": "^6.1.5",
    "globals": "catalog:",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "catalog:",
    "vite": "^8.3.8",
    "vitest": "catalog:",
    "zod": "^4.6.7"
  }
}
